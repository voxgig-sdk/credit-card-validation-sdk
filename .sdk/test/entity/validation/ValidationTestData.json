    "GET /stripe.php": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "validateCreditCard",
        "parameters": [
          {
            "description": "Credit card number to validate",
            "in": "query",
            "name": "cc",
            "required": true,
            "schema": {
              "example": "4532015112830366",
              "pattern": "^[0-9]{13,19}$",
              "type": "string"
