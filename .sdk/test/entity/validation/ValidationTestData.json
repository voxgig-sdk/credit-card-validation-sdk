          },
          {
            "description": "Expiration date in MM/YY or MM/YYYY format",
            "in": "query",
            "name": "exp",
            "required": false,
            "schema": {
              "example": "12/25",
              "pattern": "^(0[1-9]|1[0-2])\\/([0-9]{2}|[0-9]{4})$",
              "type": "string"
            }
          },
          {
            "description": "Card verification value (CVV/CVC)",
            "in": "query",
            "name": "cvv",
            "required": false,
            "schema": {
              "example": "123",
              "pattern": "^[0-9]{3,4}$",
              "type": "string"
            }
          }
